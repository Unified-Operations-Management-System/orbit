{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "generate": {
      "inputs": ["src/**", "redocly.yaml"],
      "outputs": ["dist/openapi.yaml"]
    },
    "lint": {
      "inputs": ["src/**", "redocly.yaml"]
    },
    "mock": {
      "dependsOn": ["generate"],
      "cache": false,
      "persistent": true
    }
  }
}

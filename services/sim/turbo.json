{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "generate": {
      "outputs": ["build/**"]
    },
    "build": {
      "dependsOn": ["generate"],
      "inputs": ["CMakeLists.txt", "src/**", "tests/**"],
      "outputs": ["build/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["CMakeLists.txt", "src/**", "tests/**"]
    }
  }
}

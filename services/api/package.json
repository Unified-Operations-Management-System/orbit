{
  "name": "api",
  "private": true,
  "description": "Go backend. This package.json only exists so Turborepo can orchestrate Go tasks.",
  "scripts": {
    "dev": "go run ./cmd/api",
    "build": "go build -trimpath -o bin/api ./cmd/api",
    "generate": "go generate ./internal/oapi",
    "test": "go test ./...",
    "lint": "go vet ./...",
    "start": "./bin/api",
    "dev:prod": "ORBIT_ENV=prod go run ./cmd/api",
    "db:new": "go run ./cmd/dbtool new",
    "db:status": "go run ./cmd/dbtool status",
    "db:reset": "go run ./cmd/dbtool reset"
  },
  "devDependencies": {
    "@orbit/api-spec": "workspace:*"
  }
}
